<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#000000</item><item name="android:navigationBarColor">#000000</item>
        <item name="android:colorAccent">#B1C7FA</item><item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowBackground">#000000</item><item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F3F5FA</item><item name="android:navigationBarColor">#F3F5FA</item>
        <item name="android:colorAccent">#355DA5</item><item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowBackground">#F3F5FA</item>
    </style>
</resources>